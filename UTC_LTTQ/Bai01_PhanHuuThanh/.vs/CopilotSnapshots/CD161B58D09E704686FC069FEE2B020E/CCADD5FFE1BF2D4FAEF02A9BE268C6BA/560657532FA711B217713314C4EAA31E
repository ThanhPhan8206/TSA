        private void btnThemDS_Click(object sender, EventArgs e)
        {
            if (txtMaKH.Text.Trim().Length != 6)
            {
                MessageBox.Show("Mã khách hàng phải có đúng 6 ký tự!", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                txtMaKH.Focus();
                return;
            }

            if (string.IsNullOrWhiteSpace(txtHoTen.Text) || string.IsNullOrWhiteSpace(txtDiaChi.Text))
            {
                MessageBox.Show("Họ tên và địa chỉ không được để trống!", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            DateTime NgayChot;
            if (!DateTime.TryParse(txtNgayChot.Text, out NgayChot))
            {
                MessageBox.Show("Ngày chốt không hợp lệ (định dạng dd/MM/yyyy)!", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                txtNgayChot.Focus();
                return;
            }

            int soTruoc, soNay;
            if (!int.TryParse(txtSoThangTruoc.Text, out soTruoc) || !int.TryParse(txtSoThangNay.Text, out soNay))
            {
                MessageBox.Show("Số tháng trước và số tháng này phải là số nguyên!", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            if (soTruoc >= soNay)
            {
                MessageBox.Show("Số tháng này phải lớn hơn số tháng trước!", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                txtSoThangTruoc.Focus();
                return;
            }

            int soTieuThu = soNay - soTruoc;
            double tienDien = 0;

            if (tienDien <= 50)
            {
                tienDien = soTieuThu * 100;
            }
            else if (tienDien <= 100)
            {
                tienDien = 50 * 100 + (soTieuThu - 50) * 200;
            }
            else if(tienDien <= 200)
            {
                tienDien = 50 * 100 + 50 * 200 + (soTieuThu - 100) * 300;
            }

            double tongTien = tienDien * 1.1;

            string itemText = $"{txtMaKH.Text.Trim()} | {txtHoTen.Text.Trim()} | {txtDiaChi.Text.Trim()} | {NgayChot.ToShortDateString()} | {soTruoc} | {soNay} | {tongTien:N0}";
            lstDanhSach.Items.Add(itemText);

            MessageBox.Show("Khách hàng thêm thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);

        }


        private string ShowInputBox(string title, string promptText)
        {
            Form form = new Form();
            Label label = new Label();
            TextBox texBox = new TextBox();
            Button buttonOk = new Button();
            Button buttonCancel = new Button();

            form.Text = title;
            label.Text = promptText;
            buttonOk.Text = "OK";
            buttonCancel.Text = "Cancel";
            buttonOk.DialogResult = DialogResult.OK;
            buttonCancel.DialogResult = DialogResult.Cancel;

            label.SetBounds(9, 20, 372, 13);
            textBox.SetBounds(12, 36, 372, 20);
            buttonOk.SetBounds(228, 72, 75, 23);
            buttonCancel.SetBounds(309, 72, 75, 23);

            label.AutoSize = true;
            textBox.Anchor = AnchorStyles.Top | AnchorStyles.Left | AnchorStyles.Right;
            buttonOk.Anchor = AnchorStyles.Bottom | AnchorStyles.Right;
            buttonCancel.Anchor = AnchorStyles.Bottom | AnchorStyles.Right;

            form.ClientSize = new Size(396, 107);
            form.Controls.AddRange(new Control[] { label, textBox, buttonOk, buttonCancel });
            form.FormBorderStyle = FormBorderStyle.FixedDialog;
            form.StartPosition = FormStartPosition.CenterScreen;
            form.MinimizeBox = false;
            form.MaximizeBox = false;
            form.AcceptButton = buttonOk;
            form.CancelButton = buttonCancel;

            return DialogResult.OK == form.ShowDialog() ? textBox.Text : string.Empty;
        }
   
        private void btnTimKiem_Click(object sender, EventArgs e)
        {
            string tenTimKiem = ShowInputBox("Tìm kiếm", "Nhập họ tên khách hàng muốn tìm kiếm:");

            if (string.IsNullOrWhiteSpace(tenTimKiem)) return;

            bool found = false;
            foreach (var item in lstDanhSach.Items)
            {
                string row = item.ToString();
                string[] parts = row.Split('|');
                if (parts.Length >= 2)
                {
                    string hoTenInList = parts[1].Trim();
                    string tienPhaiTra = parts[parts.Length - 1].Trim();

                    if (hoTenInList.Equals(tenTimKiem.Trim(), StringComparison.OrdinalIgnoreCase))
                    {
                        MessageBox.Show($"Khách hàng: {hoTenInList}\nSố tiền phải trả: {tienPhaiTra}", "Kết quả tìm kiếm", MessageBoxButtons.OK, MessageBoxIcon.Information);
                        found = true;
                        break;
                    }
                }
            }

            if (!found)
            {
                MessageBox.Show($"Khách hàng \"{tenTimKiem}\" hiện chưa có trong danh sách.", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
        }

